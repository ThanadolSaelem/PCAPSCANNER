# Copy this to a private, ignored file (for example .env.osint) and chmod 600.
# Do not commit real keys. Configure only providers whose terms/license cover
# your intended organizational use. Every lookup still requires per-operation UI consent.
PCAP_OSINT_ENABLED=0

PCAP_OSINT_VIRUSTOTAL_API_KEY=
PCAP_OSINT_VIRUSTOTAL_PREMIUM_LICENSE_ACK=0

PCAP_OSINT_ABUSEIPDB_API_KEY=
PCAP_OSINT_ABUSEIPDB_TERMS_ACK=0

PCAP_OSINT_GREYNOISE_API_KEY=
PCAP_OSINT_GREYNOISE_LICENSE_ACK=0

PCAP_OSINT_SHODAN_API_KEY=
PCAP_OSINT_SHODAN_AUTOMATION_ACK=0
PCAP_OSINT_SHODAN_QUERY_LOG_REDACTION_ACK=0

PCAP_OSINT_OTX_API_KEY=
PCAP_OSINT_OTX_AUTHORIZED_USE_ACK=0
